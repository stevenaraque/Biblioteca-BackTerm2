@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* ✅ NUEVO: quién está conectado. Corre en el navegador (WASM), por eso lleva su @rendermode. *@
            <EstadoSesion @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>