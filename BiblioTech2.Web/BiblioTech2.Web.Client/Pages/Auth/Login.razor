@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthApiService Auth
@inject NavigationManager Navegacion
 
<PageTitle>Iniciar sesión</PageTitle>
 
<div class="col-md-5">
    <h1>Iniciar sesión</h1>
 
    <AuthorizeView>
        <Authorized>
            <div class="alert alert-info">
                Ya iniciaste sesión como <strong>@context.User.Identity?.Name</strong>.
                <a href="autores">Ir a Autores</a>
            </div>
        </Authorized>
        <NotAuthorized>
            <Alerta Mensaje="@mensaje" Exito="false" Errores="@errores" OnCerrar="() => mensaje = null" />
 
            <EditForm Model="login" OnValidSubmit="EntrarAsync" Context="formulario">
                <DataAnnotationsValidator />
 
                <div class="mb-3">
                    <label class="form-label" for="email">Correo</label>
                    <InputText id="email" type="email" class="form-control" autocomplete="username"
                               @bind-Value="login.Email" />
                    <ValidationMessage For="() => login.Email" class="text-danger" />
                </div>
 
                <div class="mb-3">
                    <label class="form-label" for="password">Contraseña</label>
                    <InputText id="password" type="password" class="form-control" autocomplete="current-password"
                               @bind-Value="login.Password" />
                    <ValidationMessage For="() => login.Password" class="text-danger" />
                </div>
 
                <button type="submit" class="btn btn-primary" disabled="@entrando">
                    @(entrando ? "Entrando..." : "Entrar")
                </button>
            </EditForm>
        </NotAuthorized>
    </AuthorizeView>
</div>
 
@code {
    // A dónde volver después de entrar: login?volver=autores%2Fnuevo
    [SupplyParameterFromQuery(Name = "volver")] public string? Volver { get; set; }
 
    private LoginDto login = new();
    private bool entrando;
    private string? mensaje;
    private Dictionary<string, string[]>? errores;
 
    private async Task EntrarAsync()
    {
        entrando = true;
        mensaje = null;
        errores = null;
 
        var respuesta = await Auth.LoginAsync(login);
        entrando = false;
 
        if (respuesta.Exito)
        {
            Navegacion.NavigateTo(EsRutaLocal(Volver) ? Volver! : "autores");
            return;
        }
 
        // 401 → "Correo o contraseña incorrectos."  |  400 → errores por campo
        mensaje = respuesta.Mensaje;
        errores = respuesta.Errores;
        login.Password = string.Empty;
    }
 
    // Solo volvemos a rutas de NUESTRA app (nunca a "https://otro-sitio.com").
    private static bool EsRutaLocal(string? ruta)
        => !string.IsNullOrWhiteSpace(ruta) && !ruta.Contains("://") && !ruta.StartsWith("//");
}